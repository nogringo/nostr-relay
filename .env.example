# Copy to .env and fill in. Consumed by docker compose (env_file) and the relay.
# All values are optional; unset ones are simply left out of the NIP-11 document.

# NIP-11 relay metadata
RELAY_NAME=My Nostr Relay
RELAY_DESCRIPTION=A personal nostr relay

# Operator pubkey, hex or npub
#RELAY_PUBKEY=

# Contact, e.g. mailto:you@example.com
#RELAY_CONTACT=

# Square icon image URL
#RELAY_ICON=

# Wide banner image URL
#RELAY_BANNER=

# Inbound push notifications for NIP-59 gift wraps. Set all three values to
# enable notifications; leaving any one empty disables this integration.
#INBOUND_NOTIFICATIONS_URL=https://api.example.com/inbound/notifications
#INBOUND_NOTIFICATIONS_TOKEN=change-me
#RELAY_URLS=wss://relay1.example.com,wss://relay2.example.com

# Listen address. The image defaults to 0.0.0.0:3334; only set this for a direct
# (non-docker) run. Keep 0.0.0.0 inside a container or it becomes unreachable.
#LISTEN_ADDR=127.0.0.1:3334
